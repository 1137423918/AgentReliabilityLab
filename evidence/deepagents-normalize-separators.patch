@@ -12,6 +12,41 @@ from deepagents.graph import create_deep_agent
 from tests.unit_tests.chat_model import GenericFakeChatModel
 
 
+def test_mixed_separator_write_can_be_read_by_canonical_path() -> None:
+    """Writing through a mixed-separator alias must create a canonically readable file."""
+    path = "/workspace/notes.txt"
+    model = GenericFakeChatModel(
+        messages=iter(
+            [
+                AIMessage(
+                    content="",
+                    tool_calls=[
+                        {
+                            "name": "write_file",
+                            "args": {"file_path": r"/workspace\.\notes.txt", "content": "canonical marker"},
+                            "id": "write_alias",
+                            "type": "tool_call",
+                        }
+                    ],
+                ),
+                AIMessage(
+                    content="",
+                    tool_calls=[{"name": "read_file", "args": {"file_path": path}, "id": "read_canonical", "type": "tool_call"}],
+                ),
+                AIMessage(content="Done."),
+            ]
+        )
+    )
+    agent = create_deep_agent(model=model, backend=StateBackend())
+    result = agent.invoke({"messages": [HumanMessage(content="Write a note and read it back.")]})
+
+    assert set(result["files"]) == {path}
+    assert result["files"][path]["content"] == "canonical marker"
+    reply = next(message for message in result["messages"] if isinstance(message, ToolMessage) and message.tool_call_id == "read_canonical")
+    assert reply.status == "success"
+    assert "canonical marker" in reply.content
+
+
