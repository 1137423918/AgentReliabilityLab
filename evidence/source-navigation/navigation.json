        "id": "L846:0",
        "name": "validate_path",
        "name_truncated": false,
        "kind": "FunctionDef",
        "start_line": 846,
        "end_line": 909
      },
      "total": 64,
      "items": [
        {
          "line": 846,
          "text": "def validate_path(path: str, *, allowed_prefixes: Sequence[str] | None = None) -> str:"
        },
        {
          "line": 847,
          "text": "    r\"\"\"Validate and normalize file path for security."
        },
        {
          "line": 848,
          "text": ""
        },
        {
          "line": 849,
          "text": "    Ensures paths are safe to use by preventing directory traversal attacks"
        },
        {
          "line": 850,
          "text": "    and enforcing consistent formatting. All paths are normalized to use"
        },
        {
          "line": 851,
          "text": "    forward slashes and start with a leading slash."
        },
        {
          "line": 852,
          "text": ""
        },
        {
          "line": 853,
          "text": "    This function is designed for virtual filesystem paths and rejects"
        },
        {
          "line": 854,
          "text": "    Windows absolute paths (e.g., `C:/...`, `F:/...`) to maintain consistency"
        },
        {
          "line": 855,
          "text": "    and prevent path format ambiguity."
        },
        {
          "line": 856,
          "text": ""
        },
        {
          "line": 857,
          "text": "    Args:"
        },
        {
          "line": 858,
          "text": "        path: The path to validate and normalize."
        },
        {
          "line": 859,
          "text": "        allowed_prefixes: Optional list of allowed path prefixes."
        },
        {
          "line": 860,
          "text": ""
        },
        {
          "line": 861,
          "text": "            If provided, the normalized path must start with one of"
        },
        {
          "line": 862,
          "text": "            these prefixes."
        },
        {
          "line": 863,
          "text": ""
        },
        {
          "line": 864,
          "text": "    Returns:"
        },
        {
          "line": 865,
          "text": "        Normalized canonical path starting with `/` and using forward slashes."
        },
        {
          "line": 866,
          "text": ""
        },
        {
          "line": 867,
          "text": "    Raises:"
        },
        {
          "line": 868,
          "text": "        ValueError: If path contains traversal sequences (`..` or `~`), is a"
        },
        {
          "line": 869,
          "text": "            Windows absolute path (e.g., `C:/...`), or does not start with an"
        },
        {
          "line": 870,
          "text": "            allowed prefix when `allowed_prefixes` is specified."
        },
        {
          "line": 871,
          "text": ""
        },
        {
          "line": 872,
          "text": "    Example:"
        },
        {
          "line": 873,
          "text": "        ```python"
        },
        {
          "line": 874,
          "text": "        validate_path(\"foo/bar\")  # Returns: \"/foo/bar\""
        },
        {
          "line": 875,
          "text": "        validate_path(\"/./foo//bar\")  # Returns: \"/foo/bar\""
        },
        {
          "line": 876,
          "text": "        validate_path(\"../etc/passwd\")  # Raises ValueError"
        },
        {
          "line": 877,
          "text": "        validate_path(r\"C:\\\\Users\\\\file.txt\")  # Raises ValueError"
        },
        {
          "line": 878,
          "text": "        validate_path(\"/data/file.txt\", allowed_prefixes=[\"/data/\"])  # OK"
        },
        {
          "line": 879,
          "text": "        validate_path(\"/etc/file.txt\", allowed_prefixes=[\"/data/\"])  # Raises ValueError"
        },
        {
          "line": 880,
          "text": "        ```"
        },
        {
          "line": 881,
          "text": "    \"\"\""
        },
        {
          "line": 882,
          "text": "    # Check for traversal as a path component (not substring) to avoid"
        },
        {
          "line": 883,
          "text": "    # false-positive rejection of legitimate filenames like \"foo..bar.txt\""
        },
        {
          "line": 884,
          "text": "    parts = PurePosixPath(to_posix_path(path)).parts"
        },
        {
          "line": 885,
          "text": "    if \"..\" in parts or path.startswith(\"~\"):"
        },
        {
          "line": 886,
          "text": "        msg = f\"Path traversal not allowed: {path}\""
        },
        {
          "line": 887,
          "text": "        raise ValueError(msg)"
        },
        {
          "line": 888,
          "text": ""
        },
        {
          "line": 889,
          "text": "    # Reject Windows absolute paths (e.g., C:\\..., D:/...)"
        },
        {
          "line": 890,
          "text": "    if re.match(r\"^[a-zA-Z]:\", path):"
        },
        {
          "line": 891,
          "text": "        msg = f\"Windows absolute paths are not supported: {path}. Please use virtual paths starting with / (e.g., /workspace/file.txt)\""
        },
        {
          "line": 892,
          "text": "        raise ValueError(msg)"
        },
        {
          "line": 893,
          "text": ""
        },
        {
          "line": 894,
          "text": "    normalized = os.path.normpath(path)"
        },
        {
          "line": 895,
          "text": "    normalized = normalized.replace(\"\\\\\", \"/\")"
        },
        {
          "line": 896,
          "text": ""
        },
        {
          "line": 897,
          "text": "    if not normalized.startswith(\"/\"):"
        },
        {
          "line": 898,
          "text": "        normalized = f\"/{normalized}\""
        },
        {
          "line": 899,
          "text": ""
        },
        {
          "line": 900,
          "text": "    # Defense-in-depth: verify normpath didn't produce traversal"
        },
        {
          "line": 901,
          "text": "    if \"..\" in normalized.split(\"/\"):"
        },
        {
          "line": 902,
          "text": "        msg = f\"Path traversal detected after normalization: {path} -> {normalized}\""
        },
        {
          "line": 903,
          "text": "        raise ValueError(msg)"
        },
        {
          "line": 904,
          "text": ""
        },
        {
          "line": 905,
          "text": "    if allowed_prefixes is not None and not any(normalized.startswith(prefix) for prefix in allowed_prefixes):"
        },
        {
          "line": 906,
          "text": "        msg = f\"Path must start with one of {allowed_prefixes}: {path}\""
        },
        {
          "line": 907,
          "text": "        raise ValueError(msg)"
        },
        {
          "line": 908,
          "text": ""
        },
        {
          "line": 909,
          "text": "    return normalized"
        }
      ],
      "next_offset": null
    }
