      "total": 22,
      "items": [
        {
          "line": 822,
          "text": "def to_posix_path(path: str) -> str:"
        },
        {
          "line": 823,
          "text": "    r\"\"\"Normalize backslash separators to forward slashes for `PurePosixPath` use."
        },
        {
          "line": 824,
          "text": ""
        },
        {
          "line": 825,
          "text": "    Backends running on Windows return OS-native paths using backslashes."
        },
        {
          "line": 826,
          "text": "    `PurePosixPath` treats backslashes as literal filename characters,"
        },
        {
          "line": 827,
          "text": "    so `PurePosixPath(r\"C:\\a\\b\").name` yields the full string instead"
        },
        {
          "line": 828,
          "text": "    of `\"b\"`. Normalize before constructing a `PurePosixPath`."
        },
        {
          "line": 829,
          "text": ""
        },
        {
          "line": 830,
          "text": "    This is best-effort: a POSIX directory literally named with a backslash"
        },
        {
          "line": 831,
          "text": "    will also be rewritten. That trade-off is accepted because such filenames"
        },
        {
          "line": 832,
          "text": "    are vanishingly rare in practice and the alternative (gating on `os.sep`)"
        },
        {
          "line": 833,
          "text": "    fails when a Windows-style path is handed to a non-Windows process."
        },
        {
          "line": 834,
          "text": ""
        },
        {
          "line": 835,
          "text": "    Args:"
        },
        {
          "line": 836,
          "text": "        path: Path string that may use backslash separators."
        },
        {
          "line": 837,
          "text": ""
        },
        {
          "line": 838,
          "text": "    Returns:"
        },
        {
          "line": 839,
          "text": "        The same path with every `\\\\` replaced by `/`."
        },
        {
          "line": 840,
          "text": ""
        },
        {
          "line": 841,
          "text": "            Inputs that already use forward slashes are returned unchanged."
        },
        {
          "line": 842,
          "text": "    \"\"\""
        },
        {
          "line": 843,
          "text": "    return path.replace(\"\\\\\", \"/\")"
        }
      ],
      "next_offset": null
    },
