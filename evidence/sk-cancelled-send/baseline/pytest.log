    async def test_late_send_failure_after_sender_cancellation(failure_source: str, cancel_sender: bool) -> None:
        started = Event()
        release = Event()
        finished = Event()
    
        async def fail() -> None:
            started.set()
            await release.wait()
            finished.set()
