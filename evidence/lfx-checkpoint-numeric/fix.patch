@@ -0,0 +1,26 @@
+"""Code-wireable numeric producer/consumer for durable checkpoint tests."""
+
+from lfx.custom import Component
+from lfx.io import DataInput, Output, StrInput
+from lfx.schema.data import Data
+from lfx.schema.message import Message
+
+
+class NumericProducer(Component):
+    display_name = "Numeric Producer"
+    name = "NumericProducer"
+    inputs = [StrInput(name="number", value="inf")]
+    outputs = [Output(name="out", display_name="Out", method="produce")]
+
+    def produce(self) -> Data:
+        return Data(data={"score": float(self.number)})
+
+
+class NumericConsumer(Component):
+    display_name = "Numeric Consumer"
+    name = "NumericConsumer"
+    inputs = [DataInput(name="record")]
+    outputs = [Output(name="out", display_name="Out", method="consume")]
+
+    def consume(self) -> Message:
+        return Message(text=str(self.record.data["score"] > 0))
diff --git a/src/lfx/tests/unit/graph/checkpoint/test_nonfinite.py b/src/lfx/tests/unit/graph/checkpoint/test_nonfinite.py
new file mode 100644
index 0000000..a992e62
--- /dev/null
+++ b/src/lfx/tests/unit/graph/checkpoint/test_nonfinite.py
@@ -0,0 +1,74 @@
+"""Checkpoint numerics must be faithful or explicitly marked for recomputation."""
+
+from __future__ import annotations
+
+import json
+import math
+import sys
+from pathlib import Path
+
+import pytest
+from lfx.graph import Graph
+from lfx.graph.checkpoint.schema import deserialize_value, serialize_value, wire_has_opaque_drop
+from lfx.schema.data import Data
+from lfx.services.durable.sqlite_checkpoints import SqliteCheckpointStore
+
+sys.path.insert(0, str(Path(__file__).parent))
+from _numeric_checkpoint_components import NumericConsumer, NumericProducer
+
+
+@pytest.mark.parametrize("number", [float("nan"), float("inf"), float("-inf")], ids=["nan", "inf", "negative-inf"])
+def test_nonfinite_scalars_are_explicit_checkpoint_drops(number):
+    assert serialize_value(number) is None
+
+
+@pytest.mark.parametrize("number", [float("nan"), float("inf"), float("-inf")], ids=["nan", "inf", "negative-inf"])
+def test_nested_nonfinite_values_cannot_hide_in_built_state(number):
+    wire = serialize_value({"scores": [1.0, number]})
+    assert wire_has_opaque_drop(wire)
+    json.dumps(wire, allow_nan=False)
+
+
+@pytest.mark.parametrize("number", [float("nan"), float("inf"), float("-inf")], ids=["nan", "inf", "negative-inf"])
+def test_nonfinite_lfx_model_payloads_are_explicit_drops(number):
+    assert serialize_value(Data(data={"score": number})) is None
+
+
+def test_finite_lfx_model_payload_remains_restorable():
+    wire = serialize_value(Data(data={"score": 3.25, "optional": None}))
+    assert not wire_has_opaque_drop(wire)
+    json.dumps(wire, allow_nan=False)
+    restored = deserialize_value(wire)
+    assert isinstance(restored, Data)
+    assert restored.data == {"score": 3.25, "optional": None}
+
+
+@pytest.mark.parametrize(
+    ("number", "expected", "rebuild"),
+    [("nan", "False", True), ("inf", "True", True), ("-inf", "False", True), ("0.5", "True", False)],
+)
+async def test_sqlite_resume_recomputes_unsupported_numeric_state(tmp_path, number, expected, rebuild):
+    producer = NumericProducer(_id="producer")
+    producer.set(number=number)
+    consumer = NumericConsumer(_id="consumer")
+    consumer.set(record=producer.produce)
+    graph = Graph(producer, consumer)
+    graph.set_run_id("numeric-checkpoint")
+    await graph.astep()
+    assert graph.get_vertex("producer").built
+    assert not graph.get_vertex("consumer").built
+
+    checkpoint = graph.build_checkpoint()
+    store = SqliteCheckpointStore(tmp_path / "checkpoint.sqlite")
+    await store.save(checkpoint)
+    loaded = await SqliteCheckpointStore(tmp_path / "checkpoint.sqlite").load(checkpoint.checkpoint_id)
+    assert loaded is not None
+    resumed = Graph.resume_from_checkpoint(loaded, checkpoint_store=store)
+    assert ("producer" in resumed.checkpoint_opaque_dropped_ids) is rebuild
+    assert resumed.get_vertex("producer").built is not rebuild
+
+    await resumed.process(fallback_to_env_vars=False)
+    assert resumed.get_vertex("consumer").results["out"].text == expected
+    score = resumed.get_vertex("producer").results["out"].data["score"]
+    assert isinstance(score, float)
+    assert math.isnan(score) if number == "nan" else score == float(number)
